+#[tokio::test]
+async fn buffered_transport_cancellation_drops_the_in_flight_request_once() {
+    // Given
+    let started = Arc::new(Notify::new());
+    let cancelled = Arc::new(AtomicUsize::new(0));
+    let fake = Arc::new(BlockingTransport {
+        started: started.clone(),
+        cancelled: cancelled.clone(),
+    });
+    let client =
+        HttpSyncClient::new_with_buffered_transport(crate::sync::login::SyncAuth::default(), fake);
+
+    // When
+    let task = tokio::spawn(async move { client.host_key(request()).await });
+    started.notified().await;
+    task.abort();
+    let _ = task.await;
+
+    // Then
+    assert_eq!(cancelled.load(Ordering::SeqCst), 1);
+}

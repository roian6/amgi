diff --git a/rslib/src/sync/http_client/platform.rs b/rslib/src/sync/http_client/platform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..30e90cdf27991d41014fa8c71044a04f7e0653a1
--- /dev/null
+++ b/rslib/src/sync/http_client/platform.rs
@@ -0,0 +1,154 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+use std::collections::HashMap;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use axum::http::HeaderMap;
+use axum::http::HeaderValue;
+use reqwest::StatusCode;
+use tokio::sync::oneshot;
+
+use super::transport::BufferedRequest;
+use super::transport::BufferedResponse;
+use super::transport::BufferedTransport;
+use crate::sync::error::HttpError;
+use crate::sync::error::HttpResult;
+use crate::sync::request::header_and_stream::SYNC_HEADER_NAME;
+use crate::sync::response::ORIGINAL_SIZE;
+
+type PendingRequest = oneshot::Sender<HttpResult<BufferedResponse>>;
+
+static NEXT_REQUEST_ID: AtomicU64 = AtomicU64::new(1);
+static PENDING_REQUESTS: LazyLock<Mutex<HashMap<u64, PendingRequest>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+extern "C" {
+    fn anki_swift_http_request(
+        request_id: u64,
+        url_data: *const u8,
+        url_len: usize,
+        header_data: *const u8,
+        header_len: usize,
+        body_data: *const u8,
+        body_len: usize,
+        timeout_secs: u32,
+    );
+    fn anki_swift_http_cancel(request_id: u64);
+}
+
+pub(super) struct WatchTransport;
+
+#[async_trait]
+impl BufferedTransport for WatchTransport {
+    async fn send(&self, request: BufferedRequest) -> HttpResult<BufferedResponse> {
+        let request_id = NEXT_REQUEST_ID.fetch_add(1, Ordering::Relaxed);
+        let (sender, receiver) = oneshot::channel();
+        PENDING_REQUESTS.lock().unwrap().insert(request_id, sender);
+        let _cancellation = CancellationGuard { request_id };
+        let url = request.url.as_str().as_bytes();
+        let Some(sync_header) = request.headers.get(&SYNC_HEADER_NAME) else {
+            return Err(HttpError::new_without_source(
+                StatusCode::INTERNAL_SERVER_ERROR,
+                "buffered sync request missing sync header",
+            ));
+        };
+        let sync_header = sync_header.as_bytes();
+        // SAFETY: Category 8 (FFI boundary). All pointers describe immutable
+        // buffers that remain alive for this synchronous call. The Swift ABI
+        // copies every buffer before returning and retains none of the pointers.
+        unsafe {
+            anki_swift_http_request(
+                request_id,
+                url.as_ptr(),
+                url.len(),
+                sync_header.as_ptr(),
+                sync_header.len(),
+                request.body.as_ptr(),
+                request.body.len(),
+                request.timeout_secs,
+            )
+        };
+        receiver.await.unwrap_or_else(|_| {
+            Err(HttpError::new_without_source(
+                StatusCode::BAD_GATEWAY,
+                "native transport completion channel closed",
+            ))
+        })
+    }
+}
+
+struct CancellationGuard {
+    request_id: u64,
+}
+
+impl Drop for CancellationGuard {
+    fn drop(&mut self) {
+        if PENDING_REQUESTS
+            .lock()
+            .unwrap()
+            .remove(&self.request_id)
+            .is_some()
+        {
+            // SAFETY: Category 8 (FFI boundary). The request id is an opaque
+            // value allocated here, and the Swift ABI accepts cancellation for
+            // unknown or already-completed ids as a no-op.
+            unsafe { anki_swift_http_cancel(self.request_id) };
+        }
+    }
+}
+
+pub fn complete_request(
+    request_id: u64,
+    status_code: u16,
+    original_size: i64,
+    location: Option<&[u8]>,
+    body: Vec<u8>,
+    native_error: Option<&[u8]>,
+) -> bool {
+    let Some(sender) = PENDING_REQUESTS.lock().unwrap().remove(&request_id) else {
+        return false;
+    };
+    let response = make_response(status_code, original_size, location, body, native_error);
+    sender.send(response).is_ok()
+}
+
+fn make_response(
+    status_code: u16,
+    original_size: i64,
+    location: Option<&[u8]>,
+    body: Vec<u8>,
+    native_error: Option<&[u8]>,
+) -> HttpResult<BufferedResponse> {
+    if let Some(error) = native_error {
+        return Err(HttpError::new_without_source(
+            StatusCode::BAD_GATEWAY,
+            format!("native transport: {}", String::from_utf8_lossy(error)),
+        ));
+    }
+    let status = StatusCode::from_u16(status_code).map_err(|_| {
+        HttpError::new_without_source(StatusCode::BAD_GATEWAY, "invalid native HTTP status")
+    })?;
+    let mut headers = HeaderMap::new();
+    if original_size >= 0 {
+        let value = HeaderValue::from_str(&original_size.to_string()).map_err(|_| {
+            HttpError::new_without_source(StatusCode::BAD_GATEWAY, "invalid original size")
+        })?;
+        headers.insert(ORIGINAL_SIZE.clone(), value);
+    }
+    if let Some(location) = location {
+        let value = HeaderValue::from_bytes(location).map_err(|_| {
+            HttpError::new_without_source(StatusCode::BAD_GATEWAY, "invalid redirect location")
+        })?;
+        headers.insert(reqwest::header::LOCATION, value);
+    }
+    Ok(BufferedResponse {
+        status,
+        headers,
+        body,
+    })
+}

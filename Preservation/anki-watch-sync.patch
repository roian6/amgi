+use crate::sync::request::IntoSyncRequest;
+use crate::sync::response::ORIGINAL_SIZE;
+
+const REQUEST_USER: &str = "transport-contract-user";
+const REQUEST_PASSWORD: &str = "transport-contract-password";
+const RESPONSE_KEY: &str = "transport-contract-host-key";
+
+struct FakeTransport {
+    response: Mutex<Option<HttpResult<BufferedResponse>>>,
+    request: Mutex<Option<BufferedRequest>>,
+}
+
+#[async_trait]
+impl BufferedTransport for FakeTransport {
+    async fn send(&self, request: BufferedRequest) -> HttpResult<BufferedResponse> {
+        self.request.lock().unwrap().replace(request);
+        self.response.lock().unwrap().take().unwrap()
+    }
+}
+
+struct BlockingTransport {
+    started: Arc<Notify>,
+    cancelled: Arc<AtomicUsize>,
+}
+
+struct CancelGuard(Arc<AtomicUsize>);
+
+impl Drop for CancelGuard {
+    fn drop(&mut self) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+#[async_trait]
+impl BufferedTransport for BlockingTransport {
+    async fn send(&self, _request: BufferedRequest) -> HttpResult<BufferedResponse> {
+        let _cancel_guard = CancelGuard(self.cancelled.clone());
+        self.started.notify_one();
+        pending().await
+    }
+}
+
+struct DelayedTransport {
+    response: Mutex<Option<HttpResult<BufferedResponse>>>,
+}
+
+#[async_trait]
+impl BufferedTransport for DelayedTransport {
+    async fn send(&self, _request: BufferedRequest) -> HttpResult<BufferedResponse> {
+        tokio::time::sleep(Duration::from_millis(1_100)).await;
+        self.response.lock().unwrap().take().unwrap()
+    }
+}
+
+fn request() -> crate::sync::request::SyncRequest<HostKeyRequest> {
+    HostKeyRequest {
+        username: REQUEST_USER.into(),
+        password: REQUEST_PASSWORD.into(),
+    }
+    .try_into_sync_request()
+    .unwrap()
+}
+
+fn compressed_response(status: StatusCode, body: &[u8]) -> BufferedResponse {
+    let mut headers = HeaderMap::new();
+    headers.insert(
+        ORIGINAL_SIZE.clone(),
+        HeaderValue::from_str(&body.len().to_string()).unwrap(),
+    );
+    BufferedResponse {
+        status,
+        headers,
+        body: zstd::stream::encode_all(Cursor::new(body), 0).unwrap(),
+    }
+}
+
+#[tokio::test]
+async fn buffered_transport_preserves_sync_request_and_response_contract() {
+    // Given
+    let fake = Arc::new(FakeTransport {
+        response: Mutex::new(Some(Ok(compressed_response(
+            StatusCode::OK,
+            format!(r#"{{"key":"{RESPONSE_KEY}"}}"#).as_bytes(),
+        )))),
+        request: Mutex::new(None),
+    });
+    let auth = crate::sync::login::SyncAuth {
+        hkey: "transport-contract-sync-key".into(),
+        endpoint: Some(Url::parse("https://example.invalid/base/").unwrap()),
+        io_timeout_secs: Some(5),
+    };
+    let mut client = HttpSyncClient::new_with_buffered_transport(auth, fake.clone());
+    client.set_skey("transport-contract-session".into());
+
+    // When
+    let response = client.host_key(request()).await.unwrap().json().unwrap();
+
+    // Then
+    assert_eq!(response.key, RESPONSE_KEY);
+    let captured = fake.request.lock().unwrap().take().unwrap();
+    assert_eq!(
+        captured.url.as_str(),
+        "https://example.invalid/base/sync/hostKey"
+    );
+    assert_eq!(
+        captured.headers.get("content-type").unwrap(),
+        "application/octet-stream"
+    );
+    assert_eq!(captured.timeout_secs, 5);
+    let sync_header: Value =
+        serde_json::from_slice(captured.headers.get(&SYNC_HEADER_NAME).unwrap().as_bytes())
+            .unwrap();
+    assert_eq!(sync_header["k"], "transport-contract-sync-key");
+    assert_eq!(sync_header["s"], "transport-contract-session");
+    let decoded = zstd::stream::decode_all(Cursor::new(captured.body)).unwrap();
+    let body: Value = serde_json::from_slice(&decoded).unwrap();
+    assert_eq!(body["u"], REQUEST_USER);
+    assert_eq!(body["p"], REQUEST_PASSWORD);
+}
+
+#[tokio::test]
+async fn buffered_transport_surfaces_http_status_without_following_redirect() {
+    // Given
+    let mut response = compressed_response(StatusCode::PERMANENT_REDIRECT, b"");
+    response.headers.insert(
+        "location",
+        HeaderValue::from_static("https://sync2.example.invalid/"),
+    );
+    let fake = Arc::new(FakeTransport {
+        response: Mutex::new(Some(Ok(response))),
+        request: Mutex::new(None),
+    });
+    let auth = crate::sync::login::SyncAuth {
+        endpoint: Some(Url::parse("https://example.invalid/").unwrap()),
+        ..Default::default()
+    };
+    let client = HttpSyncClient::new_with_buffered_transport(auth, fake);
+
+    // When
+    let error = client.host_key(request()).await.unwrap_err();
+
+    // Then
+    assert_eq!(error.code, StatusCode::PERMANENT_REDIRECT);
+    assert_eq!(error.context, "https://sync2.example.invalid/");
+}

+#[tokio::test]
+async fn default_client_keeps_the_reqwest_transport() {
+    // Given
+    let server = MockServer::start().await;
+    let body = format!(r#"{{"key":"{RESPONSE_KEY}"}}"#);
+    let compressed = zstd::stream::encode_all(Cursor::new(body.as_bytes()), 0).unwrap();
+    Mock::given(method("POST"))
+        .and(path("/sync/hostKey"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header(ORIGINAL_SIZE.as_str(), body.len().to_string().as_str())
+                .set_body_bytes(compressed),
+        )
+        .mount(&server)
+        .await;
+    let auth = crate::sync::login::SyncAuth {
+        endpoint: Some(Url::parse(&format!("{}/", server.uri())).unwrap()),
+        ..Default::default()
+    };
+    let client = HttpSyncClient::new(auth, reqwest::Client::new());
+
+    // When
+    let response = client.host_key(request()).await.unwrap().json().unwrap();
+
+    // Then
+    assert_eq!(response.key, RESPONSE_KEY);
+}
